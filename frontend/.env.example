# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# AI Runtime Configuration
# Preferred: Orchestrator endpoint (frontend never talks directly to Ollama)
VITE_AI_ORCHESTRATOR_URL=http://localhost:8787
VITE_AI_ORCHESTRATOR_TOKEN=

# Fallback direct provider (temporary compatibility mode)
VITE_GROQ_API_KEY=
