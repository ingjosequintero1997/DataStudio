# Backend - Agente IA gratuito con Ollama

# Ollama (ejecutándose localmente)
OLLAMA_API=http://localhost:11434/api/generate
OLLAMA_MODEL=llama2

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dsk_data
DB_USER=postgres
DB_PASSWORD=postgres

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
